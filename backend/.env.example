# Copy to .env. Set USE_MOCK=false to go live against EPE + S3.
APP_NAME=TCFC OMRC Dashboard
ENV=local
USE_MOCK=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Server-side dataset cache (one JSON per dataset; survives reloads)
DATA_DIR=./_datasets

# --- EPE API (exception data, REST) ---
EPE_BASE_URL=https://epe.your-bank.internal/api
EPE_EXCEPTIONS_PATH=exceptions/query
EPE_TIMEOUT=60
# auth scheme: bearer | apikey | basic | none
EPE_AUTH_SCHEME=bearer
EPE_AUTH_HEADER=Authorization
EPE_TOKEN=
# JSON key holding the row array in the response ("" if the response IS the array)
EPE_RESPONSE_PATH=data

# --- BRV trade data on S3 ---
S3_BUCKET=your-brv-bucket
S3_REGION=eu-west-2
# {product_type} and {date} are substituted per day in the requested window
S3_PREFIX_TEMPLATE=brv/{product_type}/dt={date}/
S3_FORMAT=parquet
# optional, for S3-compatible stores; leave blank for AWS
S3_ENDPOINT_URL=
# AWS credentials are read from the standard boto3 chain
# (env vars / ~/.aws/credentials / instance role) — do not hardcode here.
