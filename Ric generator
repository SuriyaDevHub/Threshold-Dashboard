        ("EUR", "USD"),
        ("USD", "JPY"),
        ("JPY", "USD"),   # inverted vs convention
        ("USD", "INR"),
        ("INR", "USD"),   # inverted vs convention
        ("EUR", "JPY"),
        ("GBP", "AUD"),
        ("USD", "ZAR"),
        ("USD", "TRY"),
    ]
    print(f"{'input':<12}{'root':<10}{'market pair':<16}{'inverted?':<10}{'variants (=,=R,=TDS)'}")
